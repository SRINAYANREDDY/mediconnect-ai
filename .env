PORT=8000
HOST=0.0.0.0
ENV=development

# Node.js backend origin (for CORS)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# Model paths
BLOOD_MODEL_PATH=data/models_saved/blood_model.joblib
BLOOD_SCALER_PATH=data/models_saved/blood_scaler.joblib
XRAY_MODEL_PATH=data/models_saved/xray_model.h5
ECG_MODEL_PATH=data/models_saved/ecg_model.joblib
NLP_MODEL_NAME=emilyalsentzer/Bio_ClinicalBERT

# Confidence threshold
MIN_CONFIDENCE=0.60

# API key (Node.js sends this header to authenticate)
AI_API_KEY=mediconnect_ai_secret_key_change_in_production
